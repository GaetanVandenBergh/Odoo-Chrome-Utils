{
    "manifest_version": 3,
    "name": "Odoo Task → Event Track",
    "version": "0.3",
    "description": "Create Event Track from Project Task",
    "content_scripts": [
        {
            "matches": ["https://*.odoo.com/*"],
            "js": ["bridge.js"]
        },
        {
            "world": "MAIN",
            "matches": ["https://*.odoo.com/*"],
            "js": ["content.js"],
            "run_at": "document_end"
        }
    ],
    "options_page": "options.html",
    "icons": {
        "16": "icon.png",
        "32": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },
    "permissions": ["storage"]
}
