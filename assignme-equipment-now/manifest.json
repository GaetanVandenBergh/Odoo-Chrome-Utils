{
    "manifest_version": 3,
    "name": "Assign Me an Equipment",
    "version": "0.1",
    "description": "Adds an 'Assign to me' button on Odoo maintenance equipment records.",
    "author": "Gaetan Vanden Bergh",
    "content_scripts": [
        {
            "matches": ["https://*.odoo.com/*"],
            "js": ["content.js"],
            "run_at": "document_end"
        }
    ],
    "icons": {
        "16": "icon.png",
        "32": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    }
}
